# Serves the built SPA and forwards /api/* to the backend (the /api prefix is removed,
# exactly like the Vite dev proxy). ${BACKEND_UPSTREAM} is filled in when the container starts.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Photos and videos are uploaded through the API.
    client_max_body_size 200m;

    # Easypanel's proxy sits in front; trust it to tell the real client address, and pass
    # only that address on, so the login limits cannot be fooled by a forged header.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
    }

    # Built assets carry a content hash in the name: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
