APP_ENV=development
APP_NAME="ImobIA API"
API_PREFIX=
DATABASE_URL=postgresql+psycopg://imobos:change-me@localhost:5432/imobos
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=INFO
CORS_ORIGINS=[]
BACKEND_PUBLIC_URL=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_VERSION=
EVOLUTION_TENANT_CONFIGS={}
EVOLUTION_TIMEOUT_SECONDS=10
INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_RETRY_BASE_DELAY_SECONDS=0.25
HUBSPOT_TENANT_CONFIGS={}
HUBSPOT_API_VERSION=2026-03
TECIMOB_TENANT_CONFIGS={}
TELEGRAM_TENANT_CONFIGS={}
TELEGRAM_AUTO_REPLY_ENABLED=true
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_IMAGE_MODEL=gpt-image-2
PROPERTY_MEDIA_ROOT=storage/property-images
PROPERTY_IMAGE_MAX_BYTES=10485760
PROPERTY_IMAGE_MAX_FILES=12
AI_AUTO_REPLY_ENABLED=false
AI_AUTO_SEND_TO_CHANNEL=false
MESSAGE_JOB_MAX_ATTEMPTS=5
MESSAGE_JOB_BACKOFF_SECONDS=5
MESSAGE_JOB_STALE_SECONDS=300
INTEGRATION_SECRET_KEY=
INTEGRATION_SECRET_KEY_VERSION=1
INTEGRATION_SECRET_PREVIOUS_KEYS=[]
PLATFORM_BOOTSTRAP_TOKEN=

# docker-compose
POSTGRES_DB=imobos
POSTGRES_USER=imobos
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Integration tests use a disposable PostgreSQL database.
TEST_DATABASE_URL=postgresql+psycopg://imobos:change-me@localhost:5432/imobos_test
