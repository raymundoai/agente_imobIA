# ImmobIA · variáveis de produção (copie para deploy/.env ou cole no Easypanel).
# NUNCA commite o arquivo preenchido. Gere as chaves com: sh deploy/generate-secrets.sh

# --- Endereços -------------------------------------------------------------
# Endereço público do painel da imobiliária + /api (webhooks do Asaas e da Evolution chegam aqui).
BACKEND_PUBLIC_URL=https://SEU-DOMINIO-DO-PAINEL/api
# Os painéis chamam a API pelo mesmo domínio (/api), então não há outra origem a liberar.
# Endereço do painel da imobiliária, usado nos links enviados às pessoas (ex.: nova senha).
APP_PUBLIC_URL=https://SEU-DOMINIO-DO-PAINEL
CORS_ORIGINS=[]
APP_NAME="ImmobIA API"
API_PREFIX=
LOG_LEVEL=INFO

# --- Banco ------------------------------------------------------------------
POSTGRES_DB=immobia
POSTGRES_USER=immobia
POSTGRES_PASSWORD=GERAR
BACKUP_KEEP_DAYS=14

# --- Segurança (gerar) ------------------------------------------------------
JWT_SECRET=GERAR
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Criptografa as credenciais das integrações (Fernet). Guarde uma cópia em local seguro:
# sem ela, credenciais já salvas não podem ser lidas.
INTEGRATION_SECRET_KEY=GERAR
INTEGRATION_SECRET_KEY_VERSION=1
INTEGRATION_SECRET_PREVIOUS_KEYS=[]
# Usado uma única vez para criar o primeiro admin da plataforma.
PLATFORM_BOOTSTRAP_TOKEN=GERAR

# --- Cadastro ---------------------------------------------------------------
PUBLIC_SIGNUP_ENABLED=true
# 0 = sem teste grátis: a conta espera a primeira assinatura.
TRIAL_DAYS=0

# --- Asaas (produção) -------------------------------------------------------
ASAAS_API_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=GERAR

# --- WhatsApp (Evolution no mesmo Easypanel) --------------------------------
EVOLUTION_BASE_URL=https://SUA-EVOLUTION
EVOLUTION_API_KEY=
EVOLUTION_VERSION=
EVOLUTION_TENANT_CONFIGS={}
EVOLUTION_TIMEOUT_SECONDS=10

# --- IA (OpenAI) ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_CHAT_REASONING_EFFORT=none
OPENAI_CHAT_MAX_OUTPUT_TOKENS=4000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Atendimento automático -------------------------------------------------
# Em produção o agente responde todos os números: a lista fica VAZIA.
AI_AUTO_REPLY_ENABLED=true
AI_AUTO_SEND_TO_CHANNEL=true
AI_AUTO_REPLY_ALLOWED_PHONES=[]
COMMERCIAL_AI_ATTENDANCE_WINDOW_HOURS=24
COMMERCIAL_AI_ATTENDANCE_MAX_RESPONSES=50
MESSAGE_JOB_MAX_ATTEMPTS=5
MESSAGE_JOB_BACKOFF_SECONDS=5
MESSAGE_JOB_STALE_SECONDS=300

# --- Fotos e buscas ---------------------------------------------------------
PROPERTY_STORAGE_BACKEND=local
PROPERTY_IMAGE_MAX_BYTES=10485760
PROPERTY_VIDEO_MAX_BYTES=104857600
PROPERTY_IMAGE_MAX_FILES=12
PROPERTY_LEGACY_URL_ALLOWED_HOSTS=[]
CAPTURE_JOB_MAX_ATTEMPTS=3
CAPTURE_JOB_BACKOFF_SECONDS=15
CAPTURE_JOB_STALE_SECONDS=180
CAPTURE_HTTP_CONNECT_TIMEOUT_SECONDS=5
CAPTURE_HTTP_READ_TIMEOUT_SECONDS=20
CAPTURE_SEARCH_CACHE_TTL_SECONDS=86400
CAPTURE_STANDARD_SEARCH_CREDITS=10
CAPTURE_WEB_DISCOVERY_ENABLED=false

# --- Integrações ainda não usadas no MVP -----------------------------------
HUBSPOT_TENANT_CONFIGS={}
TECIMOB_TENANT_CONFIGS={}
TELEGRAM_TENANT_CONFIGS={}
TELEGRAM_AUTO_REPLY_ENABLED=false
