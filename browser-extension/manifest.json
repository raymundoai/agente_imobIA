{
  "manifest_version": 3,
  "name": "ImobIA Captura Assistida",
  "version": "0.1.0",
  "description": "Captura anúncios renderizados da OLX e do Facebook Marketplace para revisão no ImobIA.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir captura assistida"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
